---
import '../styles/components/header.css';
import { Image } from 'astro:assets';
import navFeature from '../assets/images/item-3.png';
import navBrand from '../assets/images/item-1.png';
import navWork from '../assets/images/work-4.png';
import navPortrait from '../assets/images/header-avt.png';
import headerBg from '../assets/images/header-1.png';
import Button from './Button.astro';
import IconLogo from '../components/icons/IconLogo.astro';
import vietNam from '../assets/images/vn.png';
import worldWide from '../assets/images/w.png';

const pathname = Astro.url.pathname;
---

<header class="header">
	<a href="/" class="header-logo">
		<div class="header-logo-ic">
			<IconLogo />
		</div>
	</a>
	<div class="header-inner">
		<div class="container grid">
			<div class="header-menu">
				<div class="header-menu-inner">
					<div class="header-menu-main">
						<div class="header-menu-play">
							<div class="header-menu-play-ic" data-header-play>
								<svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none">
									<rect x="1" y="8.5" width="3" height="3" rx="1.5" fill="currentColor"/>
									<rect x="6" y="4" width="3" height="12" rx="1.5" fill="currentColor"/>
									<rect x="16" y="8.5" width="3" height="3" rx="1.5" fill="currentColor"/>
									<rect x="11" y="7" width="3" height="6" rx="1.5" fill="currentColor"/>
								</svg>
							</div>
							<div class="header-menu-play-bg"></div>
						</div>
						<div class="header-menu-main-inner">
							<div class="header-menu-name">
								<p class="txt fs-12 fw-700 trans-upper" data-header-name-text>Come my way - son tung mtp</p>
							</div>
							<div class="header-menu-dot">
								<svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 16" fill="none">
									<circle cx="8" cy="8" r="4" fill="currentColor"/>
								</svg>
							</div>
							<div class="header-menu-time">
								<p class="txt fs-12 fw-700" data-header-time>00:00</p>
							</div>
							<div class="header-menu-skip" data-header-next>
								<div class="header-menu-skip-ic">
									<svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none">
										<rect x="2" y="8" width="3" height="3" rx="1.5" fill="currentColor"/>
										<rect x="6" y="8" width="3" height="3" rx="1.5" fill="currentColor"/>
										<rect x="15" y="8" width="3" height="3" rx="1.5" fill="currentColor"/>
										<rect x="2" y="12" width="3" height="3" rx="1.5" fill="currentColor"/>
										<rect x="11" y="12" width="3" height="3" rx="1.5" fill="currentColor"/>
										<rect x="2" y="4" width="3" height="3" rx="1.5" fill="currentColor"/>
										<rect x="11" y="4" width="3" height="3" rx="1.5" fill="currentColor"/>
										<rect x="11" y="8" width="3" height="3" rx="1.5" fill="currentColor"/>
									</svg>
								</div>
							</div>
						</div>
					</div>
					
				</div>
				<Button href="/let-talk" class="header-menu-contact" data-sound-hover>Let's talk</Button>

				<div
					class="header-menu-toggle"
					data-header-toggle
					aria-label="Open navigation"
					aria-expanded="false"
				>
				<Button href="#" class="header-menu-menu btn-sc" data-sound-hover>Menu</Button>
				<Button href="#" class="header-menu-close btn-sc" data-sound-hover data-click-close>Close</Button>
				</div>
			</div>
		</div>
	</div>
	<div class="header-nav" data-header-nav data-lenis-prevent aria-hidden="true">
		<nav class="header-nav-grid" aria-label="Primary navigation">
			<div class="header-nav-links">
				<div class="header-nav-links-inner">
					<p class="txt fs-10 fw-500 trans-upper">Menu</p>
					<div class="header-nav-links-list">
						<a href="/" class:list={["header-nav-link", { "link-current": pathname === "/" }]}>
							<div class="header-nav-link-ic">
								<svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 21" fill="none">
									<path d="M10 21C10 15.3289 5.52285 10.7316 0 10.7316C0 16.4027 4.47715 21 10 21Z" fill="currentColor"/>
									<path d="M10 0C10 5.6711 5.52285 10.2684 0 10.2684C0 4.59733 4.47715 0 10 0Z" fill="currentColor"/>
									<path d="M10 21C10 15.3289 14.4772 10.7316 20 10.7316C20 16.4027 15.5228 21 10 21Z" fill="currentColor"/>
									<path d="M10 0C10 5.6711 14.4772 10.2684 20 10.2684C20 4.59733 15.5228 0 10 0Z" fill="currentColor"/>
								</svg>
							</div>
							<span class="txt fs-32 fw-600 fs-28-mb">Home</span>
						</a>
						<a href="/about" class:list={["header-nav-link", { "link-current": pathname.startsWith("/about") }]}>
							<div class="header-nav-link-ic">
								<svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 21" fill="none">
									<path d="M10 21C10 15.3289 5.52285 10.7316 0 10.7316C0 16.4027 4.47715 21 10 21Z" fill="currentColor"/>
									<path d="M10 0C10 5.6711 5.52285 10.2684 0 10.2684C0 4.59733 4.47715 0 10 0Z" fill="currentColor"/>
									<path d="M10 21C10 15.3289 14.4772 10.7316 20 10.7316C20 16.4027 15.5228 21 10 21Z" fill="currentColor"/>
									<path d="M10 0C10 5.6711 14.4772 10.2684 20 10.2684C20 4.59733 15.5228 0 10 0Z" fill="currentColor"/>
								</svg>
							</div>
							<span class="txt fs-32 fw-600">Story</span>
						</a>
						<a href="/works" class="header-nav-link">
							<div class="header-nav-link-ic">
								<svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 21" fill="none">
									<path d="M10 21C10 15.3289 5.52285 10.7316 0 10.7316C0 16.4027 4.47715 21 10 21Z" fill="currentColor"/>
									<path d="M10 0C10 5.6711 5.52285 10.2684 0 10.2684C0 4.59733 4.47715 0 10 0Z" fill="currentColor"/>
									<path d="M10 21C10 15.3289 14.4772 10.7316 20 10.7316C20 16.4027 15.5228 21 10 21Z" fill="currentColor"/>
									<path d="M10 0C10 5.6711 14.4772 10.2684 20 10.2684C20 4.59733 15.5228 0 10 0Z" fill="currentColor"/>
								</svg>
							</div>
							<span class="txt fs-32 fw-600 fs-28-mb">Works</span>
						</a>
						<a href="/playground" class="header-nav-link">
							<div class="header-nav-link-ic">
								<svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 21" fill="none">
									<path d="M10 21C10 15.3289 5.52285 10.7316 0 10.7316C0 16.4027 4.47715 21 10 21Z" fill="currentColor"/>
									<path d="M10 0C10 5.6711 5.52285 10.2684 0 10.2684C0 4.59733 4.47715 0 10 0Z" fill="currentColor"/>
									<path d="M10 21C10 15.3289 14.4772 10.7316 20 10.7316C20 16.4027 15.5228 21 10 21Z" fill="currentColor"/>
									<path d="M10 0C10 5.6711 14.4772 10.2684 20 10.2684C20 4.59733 15.5228 0 10 0Z" fill="currentColor"/>
								</svg>
							</div>
							<span class="txt fs-32 fw-600 fs-28-mb">Playground</span>
						</a>
					</div>
				</div>
				<div class="header-nav-links-thumb">
					<div class="header-nav-links-thumb-inner">
						<div class="header-nav-links-thumb-item">
							<Image class="img-df img-fill" src={headerBg} alt="header" loading="lazy" />
						</div>
					</div>
				</div>
			</div>

