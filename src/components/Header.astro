---
import '../styles/components/header.css';
import { Image } from 'astro:assets';

---

<header class="header">
	<div class="header-inner">
		<div class="container grid">
			<div class="header-menu">
				<div class="header-menu-inner">
					<div class="header-menu-main">
						<div class="header-menu-play">
							<div class="header-menu-play-ic" data-header-play>
								<svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none">
									<rect x="1" y="8.5" width="3" height="3" rx="1.5" fill="currentColor"/>
									<rect x="6" y="4" width="3" height="12" rx="1.5" fill="currentColor"/>
									<rect x="16" y="8.5" width="3" height="3" rx="1.5" fill="currentColor"/>
									<rect x="11" y="7" width="3" height="6" rx="1.5" fill="currentColor"/>
								</svg>
							</div>
						</div>
						<div class="header-menu-main-inner">
							<div class="header-menu-name">
								<p class="txt fs-12 fw-700 trans-upper" data-header-name-text>Come my way - son tung mtp</p>
							</div>
							<div class="header-menu-dot">
								<svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 16 16" fill="none">
									<circle cx="8" cy="8" r="4" fill="currentColor"/>
								</svg>
							</div>
							<div class="header-menu-time">
								<p class="txt fs-12 fw-700" data-header-time>00:00</p>
							</div>
							<div class="header-menu-skip" data-header-next>
								<div class="header-menu-skip-ic">
									<svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 20 20" fill="none">
										<rect x="2" y="8" width="3" height="3" rx="1.5" fill="currentColor"/>
										<rect x="6" y="8" width="3" height="3" rx="1.5" fill="currentColor"/>
										<rect x="15" y="8" width="3" height="3" rx="1.5" fill="currentColor"/>
										<rect x="2" y="12" width="3" height="3" rx="1.5" fill="currentColor"/>
										<rect x="11" y="12" width="3" height="3" rx="1.5" fill="currentColor"/>
										<rect x="2" y="4" width="3" height="3" rx="1.5" fill="currentColor"/>
										<rect x="11" y="4" width="3" height="3" rx="1.5" fill="currentColor"/>
										<rect x="11" y="8" width="3" height="3" rx="1.5" fill="currentColor"/>
									</svg>
								</div>
							</div>
						</div>
					</div>
					
				</div>
				<a href="#" class="header-menu-contact">
					<div class="header-menu-contact-txt">
						<span class="txt fs-12 fw-700 trans-upper">let's talk</span>
					</div>
				</a>
				<button class="header-menu-toggle">
						<div class="header-menu-btn-inner">
							<div class="header-menu-btn-txt">
								<span class="txt fs-12 fw-700 trans-upper">menu</span>
							</div>
							<div class="header-menu-btn-txt">
								<span class="txt fs-12 fw-700 trans-upper">close</span>
							</div>
						</div>
				</button>
			</div>
		</div>
	</div>
	<div class="header-overlay"></div>
</header>
