---
import '../styles/components/footer.css';
import { stegaClean } from '@sanity/client/stega';
import { getDraftModeProps } from '../sanity/lib/draft-mode';
import { loadQuery } from '../sanity/lib/load-query';
import { FOOTER_QUERY } from '../sanity/lib/queries';

type FooterData = {
	headline?: string;
	primaryActionLabel?: string;
	conversationLabel?: string;
	email?: string;
	phoneLabel?: string;
	phoneNumber?: string;
	creditGroups?: Array<{
		_key?: string;
		label?: string;
		contributors?: Array<{ _key?: string; name?: string; href?: string }>;
	}>;
	socialLinks?: Array<{ _key?: string; platform?: string; href?: string }>;
};

const fallbackCreditGroups = [
	{
		_key: 'design',
		label: 'Design',
		contributors: [
			{ _key: 'minh-hieu', name: 'Minh Hieu', href: '#' },
			{ _key: 'divo', name: 'Divo', href: 'https://www.linkedin.com/in/befidie/' },
		],
	},
	{
		_key: 'development',
		label: 'Development',
		contributors: [{ _key: 'giang-dang', name: 'Giang Dang', href: '#' }],
	},
];

const fallbackSocialLinks = [
	{ _key: 'linkedin', platform: 'linkedin', href: '#' },
	{ _key: 'dribbble', platform: 'dribbble', href: '#' },
	{ _key: 'instagram', platform: 'instagram', href: '#' },
	{ _key: 'facebook', platform: 'facebook', href: '#' },
];

const draftModeProps = getDraftModeProps(Astro.cookies);
const isDraftMode = Boolean(draftModeProps.perspectiveCookie);
const { data: footer } = await loadQuery<FooterData | null>({
	query: FOOTER_QUERY,
	...draftModeProps,
});

const headline = footer?.headline || "Let's make\nsomething people\nremember.";
const headlineLines = isDraftMode ? [] : headline.split(/\r?\n/);
const primaryActionLabel = footer?.primaryActionLabel || 'Say Hello';
const conversationLabel = footer?.conversationLabel || 'Start a conversation';
const email = footer?.email || 'hi@minhhieu.design';
const phoneLabel = footer?.phoneLabel || 'Call anytime';
const phoneNumber = footer?.phoneNumber || '(+84) 343 313 383';
const creditGroups = footer?.creditGroups?.length ? footer.creditGroups : fallbackCreditGroups;
const socialLinks = footer?.socialLinks?.length ? footer.socialLinks : fallbackSocialLinks;
const socialHref = (platform: string) =>
	stegaClean(
		socialLinks.find((item) => stegaClean(item.platform || '') === platform)?.href || '#',
	);
const emailHref = `mailto:${stegaClean(email)}`;
const phoneHref = `tel:${stegaClean(phoneNumber).replace(/[^\d+]/g, '')}`;
---

<footer class="footer">
	<div class="footer-inner">
		<div class="container grid full-h">	
			<div class="footer-main">
				<div class="footer-main-decor-left">
					<div class="footer-main-decor">
						<svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 10 20" fill="none">
							<path d="M0 10.2205C5.52282 10.2205 10 14.599 10 20C4.47718 20 0 15.6216 0 10.2205Z" fill="currentColor"/>
							<path d="M0 9.77946C5.52282 9.77946 10 5.40104 10 0C4.47718 0 0 4.37842 0 9.77946Z" fill="currentColor"/>
						</svg>
					</div>
				</div>
				<div class="footer-main-content" data-sound-hover>
					<h2
						class:list={[
							'h0',
							{ 'footer-preserve-line-breaks': isDraftMode },
						]}
					>
						{
							isDraftMode ? headline : headlineLines.map((line, index) => (
								<>
									{line}
									{index < headlineLines.length - 1 && <br />}
								</>
							))
						}
					</h2>
					<div class="footer-main-say-hello">
