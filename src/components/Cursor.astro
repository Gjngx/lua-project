---
import { Image } from 'astro:assets';
import work1 from '../assets/images/work-1.png';
---
<div class="cursor-wrap">
  <div class="cursor">
    <div class="cursor-main">
      <div class="cursor-ic-wrap">
        <div class="cursor-ic-link">
          <div class="cursor-ic-link-inner">
            <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 32 32" fill="none">
              <path d="M8 24L24 8M23.9975 22.4002V8.00016H9.5975" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </div>
      </div>
      <div class="cursor-video">
        <div class="cursor-video-inner">
          <Image class="img-df img-fill" src={work1} alt="Nike au Pompidou" loading="eager" />
        </div>
      </div>
    </div>
  </div>
</div>