---
export interface Props {
	href?: string;
	class?: string;
}

const { href = "#", class: className = "" } = Astro.props;
---
<a href={href} class={`btn ${className}`.trim()} data-button-text>
	<div class="btn-inner">
		<div class="btn-ic ic-left">
			<div class="btn-ic-inner"></div>
		</div>
		<div class="btn-txt">
			<p class="txt fs-14 fw-500" data-button-text-label><slot /></p>
		</div>
	</div>
	<div class="btn-bg"></div>
</a>
