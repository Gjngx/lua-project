---
import '../styles/global.css';
import Header from '../components/Header.astro';
import SEO from '../components/SEO.astro';
import LayoutGrid from '../components/LayoutGrid.astro';
import ScrollIndicator from '../components/ScrollIndicator.astro';
import Cursor from '../components/Cursor.astro';
import Loader from '../components/Loader.astro';

interface Props {
	title: string;
	namespace: string;
	description?: string;
}

const { title, namespace, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<SEO title={title} description={description} />
		<script is:inline>
			if ('scrollRestoration' in history) {
				history.scrollRestoration = 'manual';
			}
		</script>
	</head>
	<body class="body">
		<Cursor />
		<Header />
		<Loader />
		<div class="body-inner">
			<LayoutGrid />
			<main class="main" data-barba="wrapper">
				<div class="main-inner" data-barba="container" data-barba-namespace={namespace}>
					<slot />
				</div>
			</main>
		</div>
		<ScrollIndicator />
		<script>
			import '../core/bootstrap.js';
		</script>
	</body>
</html>
