---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/home.css';
import { Image } from 'astro:assets';
import heroPoster from '../assets/images/home-bg-poster.webp';
import heroVideoDesktop from '../assets/video/home-bg-desktop.mp4';
// import heroVideoMobile from '../assets/video/home-bg-mobile.mp4';
import work1 from '../assets/images/work-1.png';
import work2 from '../assets/images/work-2.png';
import work3 from '../assets/images/work-3.png';
import work4 from '../assets/images/work-4.png';
import item1 from '../assets/images/item-1.png';
import item2 from '../assets/images/item-2.png';
import item3 from '../assets/images/item-3.png';
import IconLogo from '../components/icons/IconLogo.astro';
import IconSun from '../components/icons/IconSun.astro';
import IconRiceFields from '../components/icons/IconRiceFields.astro';
import IconSports1 from '../components/icons/IconSports1.astro';
import IconSports2 from '../components/icons/IconSports2.astro';
import IconSports3 from '../components/icons/IconSports3.astro';
import IconCoffee from '../components/icons/IconCoffee.astro';
import IconDesign1 from '../components/icons/IconDesign1.astro';
import IconDesign2 from '../components/icons/IconDesign2.astro';
import IconHeroDecor from '../components/icons/IconHeroDecor.astro';
import IconWorksDecor from '../components/icons/IconWorksDecor.astro';
import IconWorksDecorDone from '../components/icons/IconWorksDecorDone.astro';
import IconShape1 from '../components/icons/IconShape-1.astro';
import IconShape2 from '../components/icons/IconShape-2.astro';
import IconShape3 from '../components/icons/IconShape-3.astro';
import IconShape4 from '../components/icons/IconShape-4.astro';
import IconLeafDouble from '../components/icons/IconLeafDouble.astro';
import IconArrowRight from '../components/icons/IconArrowRight.astro';
import IconHowIntroShape1 from '../components/icons/IconHowIntroShape1.astro';
import IconHowIntroShape2 from '../components/icons/IconHowIntroShape2.astro';
import IconHowIntroShape3 from '../components/icons/IconHowIntroShape3.astro';
import IconHowIntroShape4 from '../components/icons/IconHowIntroShape4.astro';
---

<Layout title="Home" namespace="home">
	<div class="home-hero-wrap" data-section="transparent">
		<div class="home-hero-bg">
			<div class="home-hero-bg-inner">
				<video
					class="home-hero-video"
					poster={heroPoster.src}
					preload="auto"
					muted
					playsinline
					disablepictureinpicture
					disableremoteplayback
					aria-hidden="true"
					tabindex="-1"
				>
					<!-- <source src={heroVideoMobile} type="video/mp4" media="(max-width: 991px)" /> -->
					<source src={heroVideoDesktop} type="video/mp4" />
				</video>
			</div>
			<div class="home-hero-bg-overlay"></div>
		</div>
		<section class="home-hero">
			<div class="container grid">
				<div class="home-hero-top top-left">
					<div class="home-hero-desc">
						<p class="txt fs-14">Open for any collaborations & offers</p>
					</div>
				</div>
				<div class="home-hero-top top-right">
					<div class="home-hero-top-title">
						<h1 class="heading fs-24 fw-400">
							Creating websites and digital products for great experiences
						</h1>
					</div>
					<div class="home-hero-top-sub-group">
						<div class="home-hero-top-sub">
							<div class="home-hero-top-ic">
								<IconSun />
							</div>
							<h2 class="heading fs-14 fw-400">
								Digital designer <br />Based in VietNam
							</h2>
						</div>
						<div class="home-hero-top-info">
							<p class="txt fs-10 fw-400">Hanoi, VietNam</p>
							<p class="txt fs-10 fw-400" data-time>00:00:00</p>
						</div>
					</div>
				</div>
				<div class="home-hero-bottom">
					<div class="home-hero-bottom-inner">
						<div class="home-hero-bottom-desc">
							<p class="txt fs-40">
								I find inspiration in the simple things: rice fields <IconRiceFields />, the energy
								of sports <IconSports1 />
								<IconSports2 />
								<IconSports3 />, a good cup of coffee <IconCoffee />, and a deep passion for design <IconDesign1
								/>
								<IconDesign2 />
							</p>
						</div>
						<div class="home-hero-bottom-action">
							<div class="home-hero-bottom-ic">
								<div class="home-hero-bottom-ic-inner">
								
								</div>
							</div>
							<a href="#" class="home-hero-bottom-link hover-line">
								<p class="txt fs-14">More about me</p>
								<div class="home-hero-bottom-link-ic">
										<div class="home-hero-bottom-link-ic-inner ic-top">
											<IconArrowRight
										/>
										</div>
										<div class="home-hero-bottom-link-ic-inner ic-bottom">
											<IconArrowRight
										/>
										</div>
								</div>
							</a>
						</div>
					</div>
					<div class="home-hero-empty"></div>
				</div>
			</div>
		</section>
		<div class="home-hero-decor">
			<div class="home-hero-decor-inner">
				<div class="home-hero-decor-svg">
					<IconHeroDecor />
				</div>
			</div>
		</div>
		<div class="home-hero-bg-overlay-main"></div>
	</div>
	<div class="home-works-wrap" id="works" data-section="light">
		<div class="home-works home-works--decor">
			<div class="container grid full-h">
				<div class="home-works-decor">
					<div class="home-works-svg">
						<div class="home-works-svg-anim">
							<IconWorksDecor />
						</div>
						<canvas class="home-works-path-canvas" aria-hidden="true"></canvas>
						<div class="home-works-svg-done">
							<IconWorksDecorDone />
						</div>
					</div>
				</div>
			</div>
		</div>
		<section class="home-works home-works--main">
			<div class="container grid full-h">
				<div class="home-works-main">
					<div class="home-works-main-title">
						<h2 class="heading fs-64 fw-700 trans-upper">Works</h2>
					</div>
					<div class="home-works-main-desc">
						<div class="home-works-main-ic">
							<IconLeafDouble mirrored />
						</div>
						<p class="txt fs-14 fw-500">Selection of featured <br />work, across industries</p>
						<div class="home-works-main-ic">
							<IconLeafDouble />
						</div>
					</div>
				</div>
				<div class="home-works-bottom">
					<div class="home-works-bottom-title">
						<h2 class="heading fs-64 fw-700 trans-upper">
							Ready to help <br />
							with your needs
						</h2>
					</div>
				</div>
			</div>
		</section>
		<canvas id="works-gl-canvas" class="works-gl-canvas" aria-hidden="true"></canvas>
		<div class="home-works-list">
			<div class="home-works-list-inner">
				<a href="#" class="home-works-item">
					<div class="home-works-item-img">
						<Image class="img-df img-fill" src={work1} alt="Joby campaign" loading="lazy" />
					</div>
					<div class="home-works-item-label">
						<div class="home-works-item-title">
							<p class="txt fs-20 fw-700">Joby</p>
						</div>
						<div class="home-works-item-categories">
							<span class="txt fs-12 fw-500">Branding</span>
							<span class="txt fs-12 fw-500" aria-hidden="true">•</span>
							<span class="txt fs-12 fw-500">Art direction</span>
						</div>
					</div>
				</a>
				<a href="#" class="home-works-item">
					<div class="home-works-item-img">
						<Image class="img-df img-fill" src={work2} alt="Air Training app" loading="lazy" />
					</div>
					<div class="home-works-item-label">
						<div class="home-works-item-title">
							<p class="txt fs-20 fw-700">Air Training</p>
						</div>
						<div class="home-works-item-categories">
							<span class="txt fs-12 fw-500">Product design </span>
							<span class="txt fs-12 fw-500" aria-hidden="true">•</span>
							<span class="txt fs-12 fw-500">App development</span>
						</div>
					</div>
				</a>
				<a href="#" class="home-works-item">
					<div class="home-works-item-img">
						<Image class="img-df img-fill" src={work3} alt="Nike au Pompidou" loading="lazy" />
					</div>
					<div class="home-works-item-label">
						<div class="home-works-item-title">
							<p class="txt fs-20 fw-700">Nike au Pompidou</p>
						</div>
						<div class="home-works-item-categories">
							<span class="txt fs-12 fw-500">Branding</span>
							<span class="txt fs-12 fw-500" aria-hidden="true">•</span>
							<span class="txt fs-12 fw-500">Art direction</span>
						</div>
					</div>
				</a>
				<a href="#" class="home-works-item">
					<div class="home-works-item-img">
						<Image class="img-df img-fill" src={work4} alt="MedExpress" loading="lazy" />
					</div>
					<div class="home-works-item-label">
						<div class="home-works-item-title">
							<p class="txt fs-20 fw-700">MedExpress</p>
						</div>
						<div class="home-works-item-categories">
							<span class="txt fs-12 fw-500">Branding</span>
							<span class="txt fs-12 fw-500" aria-hidden="true">•</span>
							<span class="txt fs-12 fw-500">Art direction</span>
						</div>
					</div>
				</a>
			</div>
		</div>
		<div class="home-works-block"></div>
		<div class="home-works-trans">
			<div class="home-works-trans-inner">
				<div class="home-works-trans-item">
					<div class="home-works-trans-item-inner">
						<IconShape1 />
					</div>
				</div>
				<div class="home-works-trans-item">
					<div class="home-works-trans-item-inner">
						<IconShape2 />
					</div>
				</div>
				<div class="home-works-trans-item">
					<div class="home-works-trans-item-inner">
						<IconShape3 />
					</div>
				</div>
				<div class="home-works-trans-item">
					<div class="home-works-trans-item-inner">
						<IconShape4 />
					</div>
				</div>
			</div>
			<canvas class="home-works-trans-canvas" aria-hidden="true"></canvas>
		</div>
		<div class="home-works-empty" data-section="reset"></div>
	</div>
	<div class="home-how-wrap">
		<section class="home-how">
			<div class="container grid">
				<div class="home-how-intro">
					<div class="home-how-intro-desc">
						<p class="txt fs-14">
							Discover the amazing features of our software that<br>
							can transform your workflow and boost productivity!<br>
							Here's what I can do for you:
						</p>
					</div>
				</div>
				<div class="home-how-intro-decor" aria-hidden="true">
					<div class="home-how-intro-decor-inner">
						<div class="home-how-intro-decor-shape-wrap">
							<div class="home-how-intro-decor-shape ic-1">
								<IconHowIntroShape2 />
							</div>
							<div class="home-how-intro-decor-shape ic-2">
								<IconHowIntroShape1 />
							</div>
						</div>
						<div class="home-how-intro-decor-shape-wrap">
							<div class="home-how-intro-decor-shape ic-3">
								<IconHowIntroShape4 />
							</div>
							<div class="home-how-intro-decor-shape ic-4">
								<IconHowIntroShape3 />
							</div>
						</div>
					</div>
				</div>
				<div class="home-how-content">
					<div class="home-how-content-inner">
						<div class="home-how-content-list">
							<div class="home-how-content-item">
								<div class="home-how-content-item-left">
									<div class="home-how-content-item-title">
										<p class="heading fs-40 fw-400">
											Digital Design
										</p>
									</div>
								</div>
								<div class="home-how-content-item-right">
									<div class="home-how-content-item-text">
										<div class="home-how-content-item-type">
											<p class="txt fs-14">UI/UX</p>
										</div>
										<div class="home-how-content-item-type">
											<p class="txt fs-14">Interactive</p>
										</div>
										<div class="home-how-content-item-type">
											<p class="txt fs-14">Website</p>
										</div>
									</div>
								</div>
							</div>
							<div class="home-how-content-item">
								<div class="home-how-content-item-left">
									<div class="home-how-content-item-title">
										<p class="heading fs-40 fw-400">Development</p>
									</div>
								</div>
								<div class="home-how-content-item-right">
									<div class="home-how-content-item-text">
										<div class="home-how-content-item-type">
											<p class="txt fs-14">Framer</p>
										</div>
										<div class="home-how-content-item-type">
											<p class="txt fs-14">Webflow</p>
										</div>
									</div>
								</div>
							</div>
							<div class="home-how-content-item">
								<div class="home-how-content-item-left">
									<div class="home-how-content-item-title">
										<p class="heading fs-40 fw-400">Branding</p>
									</div>
								</div>
								<div class="home-how-content-item-right">
									<div class="home-how-content-item-text">
										<div class="home-how-content-item-type">
											<p class="txt fs-14">Identity</p>
										</div>
										<div class="home-how-content-item-type">
											<p class="txt fs-14">Visual Systems</p>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
				<svg class="home-how-clip-defs" aria-hidden="true">
					<defs>
						{
							[1, 2, 3].map((id) => (
								<clipPath id={`home-how-clip-${id}`} clipPathUnits="objectBoundingBox">
									<path d="M .082 .095 L .958 .004 Q 1 0 .995 .042 L .954 .958 Q .95 1 .908 .995 L .042 .886 Q 0 .88 .005 .838 L .036 .142 Q .04 .1 .082 .095 Z" />
								</clipPath>
							))
						}
					</defs>
				</svg>
				<div class="home-how-thumb">
					<div class="home-how-thumb-inner">
						<div class="home-how-thumb-item">
							<div class="home-how-thumb-item-inner">
								<div class="home-how-thumb-item-img">
									<Image class="img-df img-fill" src={item1} alt="item 1" />
								</div>
							</div>
						</div>
						<div class="home-how-thumb-item">
							<div class="home-how-thumb-item-inner">
								<div class="home-how-thumb-item-img">
									<Image class="img-df img-fill" src={item2} alt="item 2" />
								</div>
							</div>
						</div>
						<div class="home-how-thumb-item">
							<div class="home-how-thumb-item-inner">
								<div class="home-how-thumb-item-img">
									<Image class="img-df img-fill" src={item3} alt="item 3" />
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="home-how-trans">
				</div>
			</div>
		</section>
	</div>
	<div class="home-playground-wrap" id="playground">
		<section class="home-playground">
			<div class="home-playground-trans-inner">
				<div class="home-playground-trans-decor-wrap">
					<div class="home-playground-trans-decor ic-1">
						<IconHowIntroShape1 />
					</div>
					<div class="home-playground-trans-decor ic-2">
						<IconHowIntroShape3 />
					</div>
					<div class="home-playground-trans-decor ic-3">
						<IconHowIntroShape2 />
					</div>
					<div class="home-playground-trans-decor ic-4">
						<IconHowIntroShape4 />
					</div>
				</div>
			</div>
			<div class="home-playground-content">
				<div class="container grid full-h">
					<div class="home-playground-content-left">
						<div class="home-playground-content-left-title">
							<h3 class="heading fs-40 fw-400">Have fun with</h3>
						</div>
					</div>
					<div class="home-playground-content-right">
						<div class="home-playground-content-right-title">
							<h3 class="heading fs-40 fw-400">the PLayground</h3>
						</div>
					</div>
				</div>
			</div>
			<div class="home-playground-main">
				<canvas
					class="home-playground-sphere-canvas"
					aria-label="Interactive patterned 3D sphere. Drag or use the arrow keys to rotate it."
					role="img"
					tabindex="0"
				></canvas>
				<div class="home-playground-sphere-hitarea" aria-hidden="true"></div>
				<div class="home-playground-card-layer" aria-hidden="true">
					<div class="home-playground-card" data-latitude="48" data-longitude="-35" data-radius="1.08" data-width="0.15" data-size="xs">
						<Image src={work4} alt="" />
					</div>
					<div class="home-playground-card" data-latitude="56" data-longitude="18" data-radius="1.12" data-width="0.24" data-size="md">
						<Image src={item2} alt="" />
					</div>
					<div class="home-playground-card" data-latitude="30" data-longitude="-12" data-radius="1.06" data-width="0.24" data-size="md">
						<Image src={item1} alt="" />
					</div>
					<div class="home-playground-card" data-latitude="12" data-longitude="-58" data-radius="1.09" data-width="0.2" data-size="sm">
						<Image src={work2} alt="" />
					</div>
					<div class="home-playground-card" data-latitude="12" data-longitude="24" data-radius="1.08" data-width="0.16" data-size="xs">
						<Image src={work4} alt="" />
					</div>
					<div class="home-playground-card" data-latitude="-2" data-longitude="62" data-radius="1.12" data-width="0.15" data-size="xs">
						<Image src={item3} alt="" />
					</div>
					<div class="home-playground-card" data-latitude="-20" data-longitude="-48" data-radius="1.1" data-width="0.27" data-size="md">
						<Image src={work3} alt="" />
					</div>
					<div class="home-playground-card" data-latitude="-24" data-longitude="22" data-radius="1.13" data-width="0.41" data-size="lg">
						<Image src={work2} alt="" />
					</div>
					<div class="home-playground-card" data-latitude="-52" data-longitude="-12" data-radius="1.1" data-width="0.17" data-size="sm">
						<Image src={work1} alt="" />
					</div>
				</div>
			</div>
		</section>
		<div class="home-playground-empty"></div>
	</div>
</Layout>
