---
import Layout from '../layouts/Layout.astro';
import '../styles/pages/home.css';
import { Image } from 'astro:assets';
import heroPoster from '../assets/images/home-bg-poster.webp';
import heroVideoDesktop from '../assets/video/home-bg-desktop.mp4';
import heroVideoMobile from '../assets/video/home-bg-mobile.mp4';
import tesla from '../assets/images/tesla.jpg';
import airofit from '../assets/images/airofit.jpg';
import vietson from '../assets/images/vietson.jpg';
import moida from '../assets/images/moida.jpg';
import digitalDesign from '../assets/images/digital-design.png';
import development from '../assets/images/development.png';
import branding from '../assets/images/branding.png';
import IconSun from '../components/icons/IconSun.astro';
import IconRiceFields from '../components/icons/IconRiceFields.astro';
import IconSports1 from '../components/icons/IconSports1.astro';
import IconSports2 from '../components/icons/IconSports2.astro';
import IconSports3 from '../components/icons/IconSports3.astro';
import IconCoffee from '../components/icons/IconCoffee.astro';
import IconDesign1 from '../components/icons/IconDesign1.astro';
import IconDesign2 from '../components/icons/IconDesign2.astro';
import IconHeroDecor from '../components/icons/IconHeroDecor.astro';
import IconWorksDecor from '../components/icons/IconWorksDecor.astro';
import IconWorksDecorDone from '../components/icons/IconWorksDecorDone.astro';
import IconShape1 from '../components/icons/IconShape-1.astro';
import IconShape2 from '../components/icons/IconShape-2.astro';
import IconShape3 from '../components/icons/IconShape-3.astro';
import IconShape4 from '../components/icons/IconShape-4.astro';
import IconLeafDouble from '../components/icons/IconLeafDouble.astro';
import IconArrowRight from '../components/icons/IconArrowRight.astro';
import IconHowIntroShape1 from '../components/icons/IconHowIntroShape1.astro';
import IconHowIntroShape2 from '../components/icons/IconHowIntroShape2.astro';
import IconHowIntroShape3 from '../components/icons/IconHowIntroShape3.astro';
import IconHowIntroShape4 from '../components/icons/IconHowIntroShape4.astro';
import Footer from '../components/Footer.astro';
import { stegaClean } from '@sanity/client/stega';
import { getDraftModeProps } from '../sanity/lib/draft-mode';
import { urlFor } from '../sanity/lib/image';
import { loadQuery } from '../sanity/lib/load-query';
import { HOME_PAGE_QUERY } from '../sanity/lib/queries';

type SanityImage = {
	asset?: {
		url?: string;
		metadata?: {
			dimensions?: {
				width?: number;
				height?: number;
			};
		};
	};
	alt?: string;
	crop?: unknown;
	hotspot?: unknown;
};

type SanityFile = {
	asset?: {
		url?: string;
		mimeType?: string;
	};
};

type HomePageData = {
	seo?: {
		title?: string;
		description?: string;
		shareImage?: SanityImage;
	};
	hero?: {
		availabilityMessage?: string;
		headline?: string;
		role?: string;
		location?: string;
		introduction?: string;
		aboutLink?: { label?: string; href?: string };
		cursorVideo?: SanityFile;
	};
	featuredWork?: {
		heading?: string;
		description?: string;
		closingStatement?: string;
		projects?: Array<{
			_key?: string;
			_id?: string;
			title?: string;
			url?: string;
			coverImage?: SanityImage;
			categories?: string[];
		}>;
	};
	capabilities?: {
		introduction?: string;
		services?: Array<{
			_key?: string;
			title?: string;
			specialties?: string[];
			image?: SanityImage;
		}>;
	};
	playground?: {
		leadIn?: string;
		link?: { label?: string; href?: string };
		gallery?: Array<{
			_key?: string;
			alt?: string;
			image?: SanityImage;
		}>;
	};
};

const getResizedImageDimensions = (image: SanityImage | undefined, targetWidth: number) => {
	const dimensions = image?.asset?.metadata?.dimensions;
	if (!dimensions?.width || !dimensions.height) {
		return { imageWidth: undefined, imageHeight: undefined };
	}

	return {
		imageWidth: targetWidth,
		imageHeight: Math.round((targetWidth * dimensions.height) / dimensions.width),
	};
};

const draftModeProps = getDraftModeProps(Astro.cookies);
const isDraftMode = Boolean(draftModeProps.perspectiveCookie);
const { data: homePage } = await loadQuery<HomePageData | null>({
	query: HOME_PAGE_QUERY,
	...draftModeProps,
});

const hero = homePage?.hero;
const cursorVideoUrl = hero?.cursorVideo?.asset?.url;
const featuredWork = homePage?.featuredWork;
const capabilities = homePage?.capabilities;
const playground = homePage?.playground;
const heroHeadline =
	hero?.headline || 'Creating websites and digital products for great experiences';
const closingStatement = featuredWork?.closingStatement || 'Ready to help\nwith your needs';
const closingStatementLines = isDraftMode ? [] : closingStatement.split(/\r?\n/);
const capabilitiesIntroduction =
	capabilities?.introduction ||
	"Discover the amazing features of my services that\ncan transform your workflow and boost productivity.\nHere's what I can do for you:";
const capabilitiesIntroductionLines = isDraftMode ? [] : capabilitiesIntroduction.split(/\r?\n/);

const fallbackProjects = [
	{
		key: 'tesla',
		title: 'Tesla education',
		url: '#',
		categories: ['Website Design'],
		localImage: tesla,
	},
	{
		key: 'airofit',
		title: 'Airofit',
		url: '#',
		categories: ['Branding', 'Mobile App Design'],
		localImage: airofit,
	},
	{
		key: 'vietson',
		title: 'Vietson logistics',
		url: '#',
		categories: ['Art Direction', 'Website Design'],
		localImage: vietson,
	},
	{
		key: 'moida',
		title: 'MOIDA Brand Identity Renewal',
		url: '#',
		categories: ['Brand Identity'],
		localImage: moida,
	},
];

const projects = featuredWork?.projects?.length
	? featuredWork.projects.map((project, index) => ({
			key: project._key || project._id || `project-${index}`,
			title: project.title || 'Untitled project',
			url: stegaClean(project.url || '#'),
			categories: project.categories || [],
			imageUrl: project.coverImage?.asset?.url
				? urlFor(project.coverImage).width(1600).quality(85).auto('format').url()
				: undefined,
			alt: stegaClean(project.coverImage?.alt || project.title || ''),
			localImage: undefined,
		}))
	: fallbackProjects.map((project) => ({ ...project, imageUrl: undefined, alt: project.title }));

const fallbackServices = [
	{
		key: 'digital-design',
		title: 'Digital Design',
		specialties: ['UI/UX', 'Interactive', 'Website'],
		localImage: digitalDesign,
	},
	{
		key: 'development',
		title: 'Development',
		specialties: ['Framer', 'Webflow'],
		localImage: development,
	},
	{
		key: 'branding',
		title: 'Branding',
		specialties: ['Identity', 'Visual Systems'],
		localImage: branding,
	},
];

const services = capabilities?.services?.length
	? capabilities.services.map((service, index) => ({
			key: service._key || `service-${index}`,
			title: service.title || 'Untitled service',
			specialties: service.specialties || [],
			imageUrl: service.image?.asset?.url
				? urlFor(service.image).width(1200).quality(85).auto('format').url()
				: undefined,
			...getResizedImageDimensions(service.image, 1200),
			alt: stegaClean(service.image?.alt || service.title || ''),
			localImage: undefined,
		}))
	: fallbackServices.map((service) => ({
			...service,
			imageUrl: undefined,
			imageWidth: undefined,
			imageHeight: undefined,
			alt: service.title,
		}));

const fallbackGallery = [
	tesla,
	branding,
	digitalDesign,
	airofit,
	vietson,
	development,
	moida,
	vietson,
	tesla,
];
const gallery = playground?.gallery?.length
	? playground.gallery.map((item, index) => ({
			key: item._key || `gallery-${index}`,
			imageUrl: item.image?.asset?.url
				? urlFor(item.image).width(1000).quality(85).auto('format').url()
				: undefined,
			localImage: undefined,
			alt: stegaClean(item.alt || ''),
		}))
	: fallbackGallery.map((localImage, index) => ({
			key: `gallery-${index}`,
			imageUrl: undefined,
			localImage,
			alt: '',
		}));

const seoTitle = stegaClean(homePage?.seo?.title || 'Home');
const seoDescription = stegaClean(
	homePage?.seo?.description || 'Astro website built for production',
);
const seoImage = homePage?.seo?.shareImage?.asset?.url
	? urlFor(homePage.seo.shareImage).width(1200).height(630).fit('crop').auto('format').url()
	: undefined;
---

<Layout
	title={seoTitle}
	description={seoDescription}
	image={seoImage}
	loaderHeadline={heroHeadline}
	namespace="home"
>
	<div class="home-hero-wrap" data-section="transparent">
		<div class="home-hero-bg">
			<div class="home-hero-bg-inner">
				<video
					class="home-hero-video"
					poster={heroPoster.src}
					preload="auto"
					muted
					playsinline
					disablepictureinpicture
					disableremoteplayback
					aria-hidden="true"
					tabindex="-1"
				>
					<source src={heroVideoMobile} type="video/mp4" media="(max-width: 767px)" />
					<source src={heroVideoDesktop} type="video/mp4" />
				</video>
			</div>
			<div class="home-hero-bg-overlay"></div>
		</div>
		<section class="home-hero" data-cursor="video" data-cursor-video={cursorVideoUrl}>
			<div class="container grid">
				<div class="home-hero-top top-left">
					<div class="home-hero-desc" data-init-hidden>
						<p class="label">
							{hero?.availabilityMessage || 'Open for any collaborations & offers'}
						</p>
					</div>
					<div class="home-hero-ic-mb hidden-dsk">
						<IconSun />
					</div>
					<div class="home-hero-sub-mb hidden-dsk">
						<p class="desc">{hero?.role || 'Digital designer based in Vietnam'}</p>
					</div>
				</div>
				<div class="home-hero-top top-right">
					<div class="home-hero-top-title">
						<h1 class="h4">
							{heroHeadline}
						</h1>
					</div>
					<div class="home-hero-top-sub-group">
						<div class="home-hero-top-sub" data-init-hidden>
							<div class="home-hero-top-ic">
								<IconSun />
							</div>
							<h2 class="desc">
								{hero?.role || 'Digital designer based in Vietnam'}
							</h2>
						</div>
						<div class="home-hero-top-info" data-init-hidden>
							<p class="label">{hero?.location || 'Hanoi, Vietnam'}</p>
							<p class="label" data-time>00:00:00</p>
						</div>
					</div>
				</div>
				<div class="home-hero-bottom">
					<div class="home-hero-bottom-inner">
						<div class="home-hero-bottom-desc">
							<p class="h2">
								{
									hero?.introduction ? (
										hero.introduction
									) : (
										<>
											I find inspiration in the simple things: rice fields <IconRiceFields />, the
											energy of sports <IconSports1 />
											<IconSports2 />
											<IconSports3 />, a good cup of coffee <IconCoffee />, and a deep passion for
											design <IconDesign1 />
											<IconDesign2 />
										</>
									)
								}
							</p>
						</div>
						<div class="home-hero-bottom-action">
							<div class="home-hero-bottom-ic">
								<div class="home-hero-bottom-ic-inner"></div>
							</div>
							<a
								href={stegaClean(hero?.aboutLink?.href || '/about')}
								class="home-hero-bottom-link hover-line"
								data-cursor="hidden"
							>
								<p class="p">{hero?.aboutLink?.label || 'More about me'}</p>
								<div class="home-hero-bottom-link-ic">
									<div class="home-hero-bottom-link-ic-inner ic-top">
										<IconArrowRight />
									</div>
									<div class="home-hero-bottom-link-ic-inner ic-bottom">
										<IconArrowRight />
									</div>
								</div>
							</a>
						</div>
					</div>
					<div class="home-hero-empty"></div>
				</div>
			</div>
		</section>
		<div class="home-hero-decor">
			<div class="home-hero-decor-inner">
				<div class="home-hero-decor-svg">
					<IconHeroDecor />
				</div>
			</div>
		</div>
		<div class="home-hero-bg-overlay-main"></div>
	</div>
	<div class="home-works-wrap" id="works" data-section="light">
		<canvas id="works-gl-canvas" class="home-works-gl-canvas" aria-hidden="true"></canvas>
		<div class="home-works home-works--decor">
			<div class="container grid full-h">
				<div class="home-works-decor">
					<div class="home-works-svg">
						<div class="home-works-svg-anim">
							<IconWorksDecor />
						</div>
						<canvas class="home-works-path-canvas" aria-hidden="true"></canvas>
						<div class="home-works-svg-done">
							<IconWorksDecorDone />
						</div>
					</div>
				</div>
			</div>
		</div>
		<section class="home-works home-works--main">
			<div class="container grid full-h">
				<div class="home-works-main">
					<div class="home-works-main-title">
						<h2 class="h1">
							{featuredWork?.heading || 'Works'}
						</h2>
					</div>
					<div class="home-works-main-desc">
						<div class="home-works-main-ic">
							<IconLeafDouble mirrored />
						</div>
						<p class="p">
							{featuredWork?.description || 'Selection of featured work, across industries'}
						</p>
						<div class="home-works-main-ic">
							<IconLeafDouble />
						</div>
					</div>
				</div>
				<div class="home-works-bottom">
					<div class="home-works-bottom-title">
						<h2
							class:list={[
								'h1',
								{ 'preserve-line-breaks': isDraftMode },
							]}
						>
							{
								isDraftMode
									? closingStatement
									: closingStatementLines.map((line, index) => (
											<>
												{line}
												{index < closingStatementLines.length - 1 && <br />}
											</>
										))
							}
						</h2>
					</div>
				</div>
			</div>
		</section>
		<div class="home-works-list">
			<div class="home-works-list-inner">
				{
					projects.map((project) => (
						<a href={project.url} class="home-works-item">
							<div class="home-works-item-img" data-cursor="ic-external">
								<div class="home-works-item-img-inner">
									{project.imageUrl ? (
										<img
											class="img-df img-fill"
											src={project.imageUrl}
											alt={project.alt}
											loading="lazy"
										/>
									) : project.localImage ? (
										<Image
											class="img-df img-fill"
											src={project.localImage}
											alt={project.alt}
											loading="lazy"
										/>
									) : null}
								</div>
							</div>
							<div class="home-works-item-label">
								<div class="home-works-item-title">
									<p class="h4">{project.title}</p>
								</div>
								<div class="home-works-item-categories">
									{project.categories.map((category, index) => (
										<>
											{index > 0 && (
												<div class="home-works-item-category-dot" aria-hidden="true">
													<svg width="100%" viewBox="0 0 12 4" fill="none" xmlns="http://www.w3.org/2000/svg">
														<path d="M0 2C3.31371 4.66667 8.68629 4.66667 12 2C8.68629 -0.666667 3.31371 -0.666666 0 2Z" fill="currentColor"/>
													</svg>
												</div>
											)}
											<span class="desc">{category}</span>
										</>
									))}
								</div>
							</div>
						</a>
					))
				}
			</div>
		</div>
		<div class="home-works-block"></div>
		<div class="home-works-trans">
			<div class="home-works-trans-inner">
				<div class="home-works-trans-item">
					<div class="home-works-trans-item-inner">
						<IconShape1 />
					</div>
				</div>
				<div class="home-works-trans-item">
					<div class="home-works-trans-item-inner">
						<IconShape2 />
					</div>
				</div>
				<div class="home-works-trans-item">
					<div class="home-works-trans-item-inner">
						<IconShape3 />
					</div>
				</div>
				<div class="home-works-trans-item">
					<div class="home-works-trans-item-inner">
						<IconShape4 />
					</div>
				</div>
			</div>
			<canvas class="home-works-trans-canvas" aria-hidden="true"></canvas>
		</div>
		<div class="home-works-empty" data-section="reset"></div>
	</div>
	<div class="home-how-wrap">
		<section class="home-how">
			<div class="container grid">
				<div class="home-how-intro">
					<div class="home-how-intro-desc">
						<p class:list={['p', { 'preserve-line-breaks': isDraftMode }]}>
							{
								isDraftMode
									? capabilitiesIntroduction
									: capabilitiesIntroductionLines.map((line, index) => (
											<>
												{line}
												{index < capabilitiesIntroductionLines.length - 1 && <br />}
											</>
										))
							}
						</p>
					</div>
				</div>
				<div class="home-how-intro-decor" aria-hidden="true">
					<div class="home-how-intro-decor-inner">
						<div class="home-how-intro-decor-shape-wrap">
							<div class="home-how-intro-decor-shape ic-1">
								<IconHowIntroShape2 />
							</div>
							<div class="home-how-intro-decor-shape ic-2">
								<IconHowIntroShape1 />
							</div>
						</div>
						<div class="home-how-intro-decor-shape-wrap">
							<div class="home-how-intro-decor-shape ic-3">
								<IconHowIntroShape4 />
							</div>
							<div class="home-how-intro-decor-shape ic-4">
								<IconHowIntroShape3 />
							</div>
						</div>
					</div>
				</div>
				<div class="home-how-content">
					<div class="home-how-content-inner">
						<div class="home-how-content-list">
							{
								services.map((service) => (
									<div class="home-how-content-item">
										<div class="home-how-content-item-left">
											<div class="home-how-content-item-title">
												<p class="h2">{service.title}</p>
											</div>
										</div>
										<div class="home-how-content-item-right">
											<div class="home-how-content-item-text">
												{service.specialties.map((specialty) => (
													<div class="home-how-content-item-type">
														<p class="desc">{specialty}</p>
													</div>
												))}
											</div>
										</div>
									</div>
								))
							}
						</div>
					</div>
				</div>
				<svg class="home-how-clip-defs" aria-hidden="true">
					<defs>
						{
							services.map((_, index) => (
								<clipPath id={`home-how-clip-${index + 1}`} clipPathUnits="objectBoundingBox">
									<path d="M .082 .095 L .958 .004 Q 1 0 .995 .042 L .954 .958 Q .95 1 .908 .995 L .042 .886 Q 0 .88 .005 .838 L .036 .142 Q .04 .1 .082 .095 Z" />
								</clipPath>
							))
						}
					</defs>
				</svg>
				<div class="home-how-thumb">
					<div class="home-how-thumb-inner">
						{
							services.map((service) => (
								<div class="home-how-thumb-item">
									<div class="home-how-thumb-item-inner">
										<div class="home-how-thumb-item-img">
											{service.imageUrl ? (
												<img
													class="img-df img-fill"
													src={service.imageUrl}
													alt={service.alt}
													width={service.imageWidth}
													height={service.imageHeight}
													loading="lazy"
												/>
											) : service.localImage ? (
												<Image class="img-df img-fill" src={service.localImage} alt={service.alt} />
											) : null}
										</div>
									</div>
								</div>
							))
						}
					</div>
				</div>
				<div class="home-how-trans"></div>
			</div>
		</section>
	</div>
	<div class="home-playground-wrap" id="playground">
		<section class="home-playground">
			<div class="home-playground-trans-inner">
				<div class="home-playground-trans-decor-wrap">
					<div class="home-playground-trans-decor ic-1">
						<IconHowIntroShape1 />
					</div>
					<div class="home-playground-trans-decor ic-2">
						<IconHowIntroShape3 />
					</div>
					<div class="home-playground-trans-decor ic-3">
						<IconHowIntroShape2 />
					</div>
					<div class="home-playground-trans-decor ic-4">
						<IconHowIntroShape4 />
					</div>
				</div>
			</div>
			<div class="home-playground-content">
				<div class="container grid full-h">
					<div class="home-playground-content-left">
						<div class="home-playground-content-left-title">
							<p class="h2">{playground?.leadIn || 'Have fun with'}</p>
						</div>
					</div>
					<div class="home-playground-content-right">
						<div class="home-playground-content-right-title">
							<a
								href={stegaClean(playground?.link?.href || '#playground')}
								class="home-playground-content-right-link hover-line"
								data-cursor="ic-external"
							>
								<p class="h2">
									{playground?.link?.label || 'the Playground'}
								</p>
							</a>
						</div>
					</div>
				</div>
			</div>
			<div class="home-playground-main">
				<div
					class="home-playground-card-layer"
					data-cursor="drag"
					role="region"
					aria-label="Interactive playground image globe"
				>
					<div class="home-playground-sphere-scale">
						<div class="home-playground-sphere-stage">
							<div class="home-playground-sphere">
								{
									gallery.map((item) => (
										<div
											class="home-playground-card"
											role="button"
											tabindex="0"
											aria-label={item.alt || 'Focus playground image'}
											aria-pressed="false"
										>
											<div class="home-playground-card-inner">
												{item.imageUrl ? (
													<img src={item.imageUrl} alt={item.alt} loading="lazy" draggable="false" />
												) : item.localImage ? (
													<Image src={item.localImage} alt={item.alt} />
												) : null}
											</div>
										</div>
									))
								}
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>
		<div class="home-playground-empty"></div>
