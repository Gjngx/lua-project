---
import {
	AUTH_COOKIE,
	SESSION_DURATION_SECONDS,
	createSession,
	hasValidAuthConfig,
	verifyPassword,
} from '../lib/auth';
import '../styles/variables.css';

const passwordHash = import.meta.env.APP_PASSWORD_HASH || process.env.APP_PASSWORD_HASH;
const secret = import.meta.env.AUTH_SECRET || process.env.AUTH_SECRET;
const configured = hasValidAuthConfig(passwordHash, secret);
const requestedTarget = Astro.url.searchParams.get('next') || '/';
const target =
	requestedTarget.startsWith('/') && !requestedTarget.startsWith('//') ? requestedTarget : '/';
let error = '';

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	const submittedPassword = String(form.get('password') || '');

	if (configured && (await verifyPassword(submittedPassword, passwordHash!))) {
		Astro.cookies.set(AUTH_COOKIE, await createSession(secret!), {
			httpOnly: true,
			secure: Astro.url.protocol === 'https:',
			sameSite: 'strict',
			path: '/',
			maxAge: SESSION_DURATION_SECONDS,
		});
		return Astro.redirect(target, 303);
	}

	error = configured
		? 'Incorrect password. Please try again.'
		: 'Authentication is not configured.';
}

Astro.response.headers.set('Cache-Control', 'no-store');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Sign in</title>
		<style>
			* {
				box-sizing: border-box;
			}
			body {
				min-height: 100vh;
				margin: 0;
				display: grid;
				place-items: center;
				padding: 24px;
				background: var(--cln-bg-gray);
				color: var(--cln-content-strong);
				font:
					16px/1.4 system-ui,
					sans-serif;
			}
			main {
				width: min(100%, 420px);
			}
			h1 {
				margin: 0 0 10px;
				font-size: clamp(36px, 9vw, 64px);
				line-height: 0.95;
			}
			p {
				margin: 0 0 28px;
				color: var(--cln-content-base);
			}
			label {
				display: block;
				margin-bottom: 8px;
				font-size: 13px;
				font-weight: 600;
				text-transform: uppercase;
			}
			input,
			button {
				width: 100%;
				border: 1px solid var(--cln-content-strong);
				border-radius: 0;
				font: inherit;
			}
			input {
				padding: 14px 16px;
				background: var(--cln-white);
			}
			button {
				margin-top: 12px;
				padding: 14px 16px;
				background: var(--cln-brand);
				font-weight: 700;
				cursor: pointer;
			}
			.error {
				margin: 12px 0 0;
				color: var(--cln-status-red);
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Hello.</h1>
			<p>Enter the password to access this website.</p>
			<form method="post" action={`/login?next=${encodeURIComponent(target)}`}>
				<label for="password">Password</label>
				<input
					id="password"
					name="password"
					type="password"
					required
					autofocus
					autocomplete="current-password"
				/>
				<button type="submit">Sign in</button>
				{
					error && (
						<p class="error" role="alert">
							{error}
						</p>
					)
				}
			</form>
		</main>
	</body>
</html>
